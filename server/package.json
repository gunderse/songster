{
  "name": "@songster/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "scan": "tsx src/scripts/scan.ts",
    "emcee:smoke": "tsx src/scripts/emcee-smoke.ts"
  },
  "dependencies": {
    "@songster/shared": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "express": "^5.2.1",
    "music-metadata": "^11.12.3",
    "pino": "^10.3.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
