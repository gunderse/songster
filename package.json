{
  "name": "songster",
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @songster/server --filter @songster/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @songster/server test",
    "db:migrate": "pnpm --filter @songster/server db:migrate"
  }
}
